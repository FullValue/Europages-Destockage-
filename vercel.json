{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/handler.js": { "includeFiles": "data/seed-lots.js", "maxDuration": 30 }
  },
  "redirects": [
    { "source": "/destock", "destination": "/destock/", "permanent": false },
    { "source": "/market", "destination": "/market/", "permanent": false },
    { "source": "/admin", "destination": "/admin/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/handler?path=:path*" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ]
}
